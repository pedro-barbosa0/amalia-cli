Screen {
    background: ansi_black;
    color: ansi_white;
}

#messages {
    height: 1fr;
    width: 100%;
    padding: 1 2;
    background: ansi_black;
}

.message {
    width: 100%;
    margin-bottom: 1;
    padding: 0 1;
}

.user {
    color: ansi_white;
    text-style: bold;
    border-left: tall ansi_yellow;
}

.assistant {
    color: ansi_white;
    border-left: tall ansi_red;
}

#input {
    dock: bottom;
    height: 3;
    margin: 0 1 1 1;
    padding: 0 1;
    background: ansi_black;
    color: ansi_white;
    border: tall ansi_red;
}

#input:focus {
    border: tall ansi_yellow;
}

Markdown {
    background: ansi_black;
}

Static {
    background: ansi_black;
}

/* SETUP - menuconfig style */

#configuration-root {
    width: 100%;
    height: 1fr;
    align: center middle;
    background: ansi_black;
}

#configuration-panel {
    width: 90%;
    max-width: 110;
    min-width: 60;
    height: 90%;
    border: tall ansi_red;
    background: ansi_black;
}

#configuration-title {
    width: 100%;
    content-align: center middle;
    text-style: bold;
    color: ansi_white;
    margin-bottom: 1;
}

#configuration-description {
    width: 100%;
    content-align: center middle;
    color: ansi_white;
    margin-bottom: 1;
}

#configuration-body {
    width: 100%;
    height: 1fr;
}

#configuration-menu {
    width: 100%;
    height: 100%;
    border: tall ansi_red;
    background: ansi_black;
}

#configuration-menu:focus {
    border: tall ansi_yellow;
}

.configuration-row-text {
    width: 100%;
    color: ansi_white;
}

ListView > ListItem.--highlight {
    background: ansi_red;
    color: ansi_white;
}



#help-title {
    border: tall ansi_red;
    color: ansi_yellow;
    margin-bottom: 1;
}

#error {
    width: 100%;
    height: 1;
    color: ansi_red;
    margin-top: 1;
}

#bottom-row {
    width: 100%;
    height: 5;

}

#configuration-actions {
    width: 20;
    height: 100%;
}

#configuration-help {
    width: 1fr;
    height: 100%;
    border: tall ansi_red;
}

#save,
#cancel {
    width: 10;
    margin-left: 1;
    margin-right: 1;
}

#save:focus,
#save:hover,
#cancel:focus,
#cancel:hover {
    background: ansi_red;
    color: ansi_white;
    border: tall ansi_yellow;
}



/* Edit dialog */

Screen {
    align: center middle;
}

#edit-dialog {
    
    width: 50%;
    max-width: 80;
    min-width: 50;
    height: auto;
   
    border: tall ansi_red;
    padding: 1 2;
    background: ansi_black;
}

#edit-title {
    width: 100%;
    content-align: center middle;
    text-style: bold;
    color: ansi_white;
    margin-bottom: 1;
}

#edit-input {
    width: 100%;
    border: tall ansi_red;
}

#edit-input:focus {
    border: tall ansi_yellow;
}

#edit-help {
    width: 100%;
    content-align: center middle;
    color: ansi_white;
    margin-top: 1;
}

/* Prompt dialog */

#prompt-dialog {
    width: 70%;
    max-width: 80;
    min-width: 50;
    height: 70%;
    border: tall ansi_red;
    padding: 1 2;
    background: ansi_black;
}

#prompt-title {
    width: 100%;
    content-align: center middle;
    text-style: bold;
    color: ansi_white;
    margin-bottom: 1;
}

#prompt-list {
    width: 100%;
    height: 1fr;
    border: tall ansi_red;
}

#prompt-list:focus {
    border: tall ansi_yellow;
}

#prompt-help {
    width: 100%;
    content-align: center middle;
    color: ansi_white;
    margin-top: 1;
}